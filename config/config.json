{
  "app": {
    "name": "Adam Voice Assistant",
    "version": "2.0.0",
    "debug": true,
    "log_level": "DEBUG"
  },
  "features": {
    "echo_detection": true,
    "auto_paste": true,
    "analytics_enabled": true,
    "command_mode": true,
    "multi_language_detect": false,
    "batch_processing": false,
    "wake_words": ["hey johnny", "johnny", "adam", "hey adam", "great", "great, can you", "johny can you", "ok, can you"],
    "wake_word_cooldown": 15
  },
  "transcription": {
    "model": "base",
    "device": "cpu",
    "compute_type": "int8",
    "cpu_threads": 4,
    "num_workers": 1,
    "language": "en",
    "beam_size": 1,
    "vad_filter": true,
    "timeout": 30,
    "retry_on_error": true,
    "max_retries": 3,
    "initial_prompt": "Adam, Hey Adam, Johnny, Hey Johnny, Claude, task, project, code, bug, test, commit, push, reload, config, dev",
    "hotwords": "Johnny:10 ShipTown:10 Adam:10"
  },
  "audio": {
    "sample_rate": 44100,
    "channels": 1,
    "format": "int16",
    "chunk_size": 1024,
    "silence_threshold": 240,
    "silence_duration": 2.0,
    "silence_threshold_ratio": 0.90,
    "min_recording_time": 1.0,
    "max_silence_timeout": 5.0,
    "buffer_size": 43
  },
  "speech": {
    "voice": "com.apple.speech.synthesis.voice.Alex",
    "rate": 200,
    "pre_speak_delay": 3,
    "mute_input_before_speak": true,
    "mute_level": 0,
    "unmute_level": 100
  },
  "paths": {
    "recordings_dir": "~/Library/Caches/johnny-voice-assistant/recordings",
    "analytics_dir": "files/analytics",
    "cache_dir": ".cache",
    "config_dir": "config"
  },
  "commands": {
    "enabled": true,
    "config_file": "config/commands.json",
    "prefix": "",
    "case_sensitive": false
  },
  "paste": {
    "delay_before_paste": 0.2,
    "delay_after_paste": 0.1,
    "send_enter": true,
    "continuation_timeout": 3.0
  },
  "modes": {
    "dictation": {
      "enabled": true,
      "auto_paste": true,
      "send_enter": true
    },
    "command": {
      "enabled": true,
      "auto_execute": true
    },
    "conversation": {
      "enabled": false,
      "keep_history": true,
      "max_history": 10
    }
  }
}
